<%- include('../partials/header', { title: 'Manage Movies - CineVerse Admin' }) %>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/admin" class="text-info small text-decoration-none mb-1 d-inline-block">← Back to Analytics</a>
            <h2 class="text-light mb-0">🎬 Movie Catalog Management</h2>
        </div>
        <button class="btn btn-cinema" data-bs-toggle="modal" data-bs-target="#addMovieModal">
            <i class="fas fa-plus me-1"></i> Add New Movie
        </button>
    </div>

    <!-- Movies Table -->
    <div class="glass-panel p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0" style="background: transparent;">
                <thead>
                    <tr class="text-muted small border-secondary">
                        <th>Poster</th>
                        <th>Title & Details</th>
                        <th>Genres</th>
                        <th>Rating</th>
                        <th>Base Price</th>
                        <th>Formats</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% movies.forEach(movie => { %>
                        <tr class="border-secondary align-middle">
                            <td style="width: 70px;">
                                <img src="<%= movie.posterUrl %>" alt="<%= movie.title %>" class="rounded" style="width: 50px; height: 70px; object-fit: cover;">
                            </td>
                            <td>
                                <div class="text-light fw-bold fs-6"><%= movie.title %></div>
                                <small class="text-muted"><%= movie.duration %> | <%= movie.certification %> | Dir: <%= movie.director %></small>
                            </td>
                            <td>
                                <span class="text-info small"><%= (movie.genre || []).join(', ') %></span>
                            </td>
                            <td>
                                <span class="badge bg-dark border border-warning text-warning">
                                    <i class="fas fa-star text-warning me-1"></i> <%= movie.rating %>
                                </span>
                            </td>
                            <td class="font-monospace text-light fw-bold">
                                ₹<%= movie.basePrice %>
                            </td>
                            <td>
                                <% (movie.formats || []).forEach(f => { %>
                                    <span class="badge bg-secondary" style="font-size: 0.7rem;"><%= f %></span>
                                <% }); %>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteMoviePrompt('<%= movie.id %>')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Movie Modal -->
<div class="modal fade" id="addMovieModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-secondary">
            <form action="/admin/movies/add" method="POST">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title text-light"><i class="fas fa-plus text-info me-2"></i> Add Movie to CineVerse Catalog</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label text-muted small">Movie Title *</label>
                            <input type="text" name="title" class="form-control bg-dark text-light border-secondary" required placeholder="e.g. Avatar: The Way of Water">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Base Price (INR) *</label>
                            <input type="number" name="basePrice" class="form-control bg-dark text-light border-secondary" required placeholder="280" value="280">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Genres (comma separated)</label>
                            <input type="text" name="genre" class="form-control bg-dark text-light border-secondary" placeholder="Action, Sci-Fi, Adventure" value="Action, Sci-Fi">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">IMDb Rating</label>
                            <input type="number" step="0.1" name="rating" class="form-control bg-dark text-light border-secondary" placeholder="8.5" value="8.5">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Duration</label>
                            <input type="text" name="duration" class="form-control bg-dark text-light border-secondary" placeholder="2h 30m" value="2h 30m">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Director</label>
                            <input type="text" name="director" class="form-control bg-dark text-light border-secondary" placeholder="James Cameron" value="James Cameron">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">YouTube Trailer ID</label>
                            <input type="text" name="trailerYoutubeId" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="d9MyW72ELq0" value="d9MyW72ELq0">
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small">Poster Image URL</label>
                            <input type="url" name="posterUrl" class="form-control bg-dark text-light border-secondary" placeholder="https://image.tmdb.org/..." value="https://image.tmdb.org/t/p/w500/t6HIqrRAclMCA60NsSmeqe9RmNV.jpg">
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small">Synopsis</label>
                            <textarea name="synopsis" rows="3" class="form-control bg-dark text-light border-secondary" placeholder="Brief storyline..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary">
                    <button type="button" class="btn btn-cinema-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-cinema">Save Movie</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    async function deleteMoviePrompt(movieId) {
        if (!confirm('Are you sure you want to remove this movie from catalog?')) return;

        try {
            const res = await fetch(`/admin/movies/delete/${movieId}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToast('Movie deleted', 'success');
                setTimeout(() => window.location.reload(), 1000);
            }
        } catch (e) {
            console.error('Delete error', e);
        }
    }
</script>

<%- include('../partials/footer') %>
