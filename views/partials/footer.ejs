                    <h6 class="text-light text-uppercase mb-3 font-monospace small">Experience</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted">
                        <li><a href="/" class="text-decoration-none text-muted hover-light">IMAX 70mm Laser</a></li>
                        <li><a href="/" class="text-decoration-none text-muted hover-light">Dolby Atmos Audio</a></li>
