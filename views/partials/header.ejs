<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | CineVerse Pro' : 'CineVerse Pro - Next-Gen Cinema Experience' %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom CineVerse CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg glass-nav py-3">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span style="font-size: 1.6rem;">🎬</span>
                <span>Cine<span class="brand-glow">Verse</span></span>
                <span class="nav-badge">PRO</span>
            </a>
            
            <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <i class="fas fa-bars"></i>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Search Bar -->
                <form class="d-flex mx-auto my-2 my-lg-0" style="max-width: 380px; width: 100%;" action="/" method="GET">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-search"></i></span>
                        <input class="form-control bg-dark text-light border-secondary" type="search" name="q" placeholder="Search movies, actors, IMAX..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                    </div>
                </form>

                <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-film me-1"></i> Movies</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard"><i class="fas fa-ticket-alt me-1"></i> My Bookings</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin"><i class="fas fa-chart-pie me-1"></i> Admin Portal</a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a href="/dashboard" class="btn btn-sm btn-cinema-outline py-2 px-3">
                            <i class="fas fa-user-circle me-1 text-info"></i>
                            <span><%= typeof userEmail !== 'undefined' && userEmail ? userEmail.split('@')[0] : 'My Account' %></span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Toast Notifications Container -->
    <div id="toast-container"></div>
