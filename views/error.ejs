<%- include('partials/header', { title: title || 'Error' }) %>

<div class="container my-5 text-center">
    <div class="glass-panel p-5 mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <i class="fas fa-exclamation-triangle fa-4x text-warning"></i>
        </div>
        <h2 class="text-light mb-3"><%= title || 'Something went wrong' %></h2>
        <p class="text-muted mb-4"><%= error || 'The requested page or resource could not be found or processed.' %></p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-cinema px-4 py-2">
                <i class="fas fa-home me-2"></i> Return Home
            </a>
            <a href="/dashboard" class="btn btn-cinema-outline px-4 py-2">
                <i class="fas fa-ticket-alt me-2"></i> My Bookings
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>